{
  "name": "jaford-private-analytics",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "COLLECTION_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "jaford-private-analytics",
    "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
  }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "triggers": { "crons": ["0 3 * * *"] }
}
